# Cursor Cloud Agents API key (server only; never ship to iOS)
CURSOR_API_KEY=cursor_

# HTTP port for the task API
PORT=8787

# Optional: require this value in Authorization: Bearer <token> (omit in dev with DEV_AUTH_BYPASS=1)
TASK_API_BEARER_TOKEN=

# Dev only: skip Bearer check when set to 1
DEV_AUTH_BYPASS=1

# Optional phase-2 cloud repos (JSON array), e.g. [{"url":"https://github.com/org/repo","ref":"main"}]
CLOUD_REPOS_JSON=

# Single repo URL shorthand (parsed into cloud.repos[0].url)
CLOUD_REPO_URL=

# Internal route: PATCH preview URL (header must match)
INTERNAL_PREVIEW_SECRET=
